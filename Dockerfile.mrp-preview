FROM node:22-bookworm-slim AS assets
WORKDIR /front
COPY mrp_frontend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY mrp_frontend/ ./
RUN npm run build
FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
COPY --from=assets /static/mrp-v2 ./static/mrp-v2
CMD ["sh","-c","exec gunicorn --worker-class gthread --workers 1 --threads 8 --timeout 60 --bind 0.0.0.0:${PORT:-10000} app:app"]
